# syntax=docker/dockerfile:1
# check=skip=FromPlatformFlagConstDisallowed
# The corpus build for the reMarkable Paper Pro (aarch64 Linux, musl), for development only (make
# install-corpus, the skill `remarkable-corpus`). Do not use it for a release.
#
#   docker build --platform linux/arm64 -f Dockerfile.corpus --output type=local,dest=dist .
#
# It is the fast build of Dockerfile.dev (the same Cargo profile, linker and cache mounts), with these
# differences:
#
# - The Cargo feature `corpus`.
# - The version `dev/corpus` in the Settings panel.
# - The name `Sudoku (corpus)` in AppLoad.
# - The same QML frontend with its own app ID (`sudoku-corpus`) and its own framebuffer ID
#   (appload/make-folder.sh; `launch::CORPUS` in src/launch.rs): no two installed apps have the
#   same IDs (REQUIREMENTS.md §14.4).
#
# The result is dist/sudoku-corpus/: a separate AppLoad folder, thus the usual Sudoku app does not
# change.

# The files of the AppLoad folder with the QML frontend (REQUIREMENTS.md §14.4): the Qt tool `rcc`
# makes resources.rcc from the QML (appload/make-folder.sh). Alpine 3.22 gives a fixed version of Qt.
# This stage keeps the Qt packages out of the Rust stage.
FROM --platform=linux/arm64 alpine:3.22 AS frontend
RUN apk add --no-cache qt6-qtbase-dev
COPY appload /appload
RUN sh /appload/make-folder.sh /out/sudoku-corpus corpus

FROM --platform=linux/arm64 rust:1.97-alpine AS build
RUN apk add --no-cache musl-dev mold
WORKDIR /src
ENV RUSTFLAGS="-C link-arg=-fuse-ld=mold"
# Only the files that the build reads (BuildKit sends only these files).
COPY Cargo.toml Cargo.lock ./
COPY src src
COPY assets assets
COPY images images
COPY tests/fixtures tests/fixtures
COPY video/demo-full.txt video/demo-full.txt
COPY --from=frontend /out/sudoku-corpus /out/sudoku-corpus
RUN --mount=type=cache,id=sudoku-dev-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=sudoku-dev-target,target=/src/target \
    SUDOKU_VERSION=dev/corpus cargo build --profile tablet-dev --locked --features corpus --bin sudoku \
 && cp target/tablet-dev/sudoku /out/sudoku-corpus/sudoku \
 && chmod 755 /out/sudoku-corpus/sudoku /out/sudoku-corpus/backend/entry

FROM scratch AS export
COPY --from=build /out /
