# syntax=docker/dockerfile:1
# check=skip=FromPlatformFlagConstDisallowed
# The color picker build for the reMarkable Paper Pro (aarch64 Linux, musl), for development only
# (make install-colors). Do not use it for a release.
#
#   docker build --platform linux/arm64 -f Dockerfile.colors --output type=local,dest=dist .
#
# It is the fast build of Dockerfile.dev (the same Cargo profile, linker and cache mounts), with these
# differences:
#
# - The program `sudoku-colors` (AppLoad starts it with the name `sudoku`).
# - The name `Sudoku (colors)` in AppLoad, and no rotation.
# - No ink patch: this app has no ink.
#
# The result is dist/sudoku-colors/: a separate AppLoad folder, thus the usual Sudoku app does not
# change.
FROM --platform=linux/arm64 rust:1.97-alpine AS build
RUN apk add --no-cache musl-dev mold
WORKDIR /src
ENV RUSTFLAGS="-C link-arg=-fuse-ld=mold"
# Only the files that the build reads (BuildKit sends only these files).
COPY Cargo.toml Cargo.lock ./
COPY src src
COPY assets assets
COPY images images
COPY scripts/icons scripts/icons
COPY tests/fixtures tests/fixtures
COPY video/demo-full.txt video/demo-full.txt
COPY appload/sudoku appload/sudoku
RUN --mount=type=cache,id=sudoku-dev-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=sudoku-dev-target,target=/src/target \
    SUDOKU_VERSION=dev/colors cargo build --profile tablet-dev --locked --bin sudoku-colors \
 && mkdir -p /out && cp -R appload/sudoku /out/sudoku-colors \
 && sed -i 's/"name": "Sudoku"/"name": "Sudoku (colors)"/; s/"supportsRotation": true/"supportsRotation": false/' /out/sudoku-colors/external.manifest.json \
 && grep -qF '"name": "Sudoku (colors)"' /out/sudoku-colors/external.manifest.json \
 && rm /out/sudoku-colors/sudoku-penregion.qmd \
 && cp target/tablet-dev/sudoku-colors /out/sudoku-colors/sudoku && chmod 755 /out/sudoku-colors/sudoku

FROM scratch AS export
COPY --from=build /out /
