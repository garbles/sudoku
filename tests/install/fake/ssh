#!/usr/bin/env bash
# A fake ssh for the installer simulation (tests/install/run.sh). It simulates the tablet with the
# files in $SIM/state:
#
#   unreachable, refused, offline   Counters. While a counter is more than 0, each connection (or each
#                                   internet check) fails and decreases it by 1.
#   wifi-unreachable                A counter as above, only for an address that is not 10.11.99.1.
#   wifi-down                       An address that is not 10.11.99.1 never answers.
#   hostkey-changed                 SSH fails with a changed host key until `ssh-keygen -R`.
#   password                        The root password.
#   authorized                      The public keys in authorized_keys.
#   default-key                     A different key of the computer opens the tablet.
#   model, os                       The device model and the software version.
#   vellum, hashtab, xovi           The parts that are installed or on.
#   vellum-stale                    Vellum says "reenable has not been run" (the tablet software
#                                   changed).
#   vellum-sync-fails               sync-vellum fails.
#   vellum-still-stale              The Vellum state is stale after sync-vellum (the reenable did not
#                                   complete).
#   tripletap                       The systemd unit xovi-tripletap is enabled and active.
#   tripletap-off                   The starter is installed, but the unit is not enabled and active.
#   tripletap-enable-sh             The file /home/root/xovi-tripletap/enable.sh is present.
#   tripletap-install-fails         Vellum cannot install the power-button starter.
#   tripletap-repair-fails          The repair does not enable and start the unit.
#   appload-update-fails            `vellum add -u appload` fails.
#   appload-update-noop             `vellum add -u appload` succeeds, but AppLoad stays old.
#   patch-delete-fails              The deletion of the old ink patch does nothing.
#
# The files of the tablet are in $SIM/tablet: $SIM/tablet/home/root is /home/root of the tablet.
# These are the AppLoad extension (xovi/extensions.d/appload.so: AppLoad 0.6.0 or newer has the text
# fbRotation), the AppLoad folder of Sudoku (xovi/exthome/appload/sudoku) and the old ink patch with
# its stamp file (xovi/exthome/qt-resource-rebuilder). The remote commands that read or change these
# files run as real commands in $SIM/tablet (refer to `tablet` below). Thus the simulation also
# examines these commands of install.sh.
#
# install.sh starts each remote command with ": name;". This file finds the command from the name.
S="$SIM/state"
batch=0 only=0 pubkey=1 key="" host="" cmd=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o)
      case "$2" in
        BatchMode=yes) batch=1 ;;
        IdentitiesOnly=yes) only=1 ;;
        PubkeyAuthentication=no) pubkey=0 ;;
      esac
      shift 2
      ;;
    -i) key="$2"; shift 2 ;;
    -*) shift ;;
    *) if [ -z "$host" ]; then host="$1"; else cmd="$1"; fi; shift ;;
  esac
done
h="${host#*@}"

# Decreases the counter $1. Returns 0 if the counter was more than 0.
count() {
  local n
  [ -f "$S/$1" ] || return 1
  n="$(cat "$S/$1")"
  [ "$n" -gt 0 ] || return 1
  echo $((n - 1)) >"$S/$1"
}

if [ "$h" != 10.11.99.1 ] && { [ -f "$S/wifi-down" ] || count wifi-unreachable; }; then
  echo "ssh: connect to host $h port 22: Operation timed out" >&2
  exit 255
fi
if count unreachable; then
  echo "ssh: connect to host $h port 22: Operation timed out" >&2
  exit 255
fi
if count refused; then
  echo "ssh: connect to host $h port 22: Connection refused" >&2
  exit 255
fi
if [ -f "$S/hostkey-changed" ]; then
  cat >&2 <<EOF
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
@    WARNING: REMOTE HOST IDENTIFICATION HAS CHANGED!     @
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
Host key verification failed.
EOF
  exit 255
fi

authed=0
if [ "$pubkey" = 1 ]; then
  if [ "$only" = 1 ]; then
    [ -n "$key" ] && [ -f "$key.pub" ] && grep -qxF "$(cat "$key.pub")" "$S/authorized" 2>/dev/null && authed=1
  else
    [ -f "$S/default-key" ] && authed=1
  fi
fi
if [ "$authed" = 0 ]; then
  if [ "$batch" = 1 ]; then
    echo "root@$h: Permission denied (publickey,password)." >&2
    exit 255
  fi
  # The real ssh reads the password from the terminal. The simulation reads it from fd 3 (the input
  # file of install.sh). The password does not show.
  tries=0
  while [ "$tries" -lt 3 ]; do
    printf "root@%s's password: " "$h" >&2
    IFS= read -r pw <&3 || pw=""
    printf '\n' >&2
    if [ "$pw" = "$(cat "$S/password")" ]; then
      authed=1
      break
    fi
    tries=$((tries + 1))
    [ "$tries" -lt 3 ] && echo "Permission denied, please try again." >&2
  done
  if [ "$authed" = 0 ]; then
    echo "root@$h: Permission denied (publickey,password)." >&2
    exit 255
  fi
fi

yes_no() { if [ -e "$S/$1" ]; then echo yes; else echo no; fi; }

# Runs the remote command on the files of the simulated tablet: /home/root/ becomes
# $SIM/tablet/home/root/. The tablet has sha256sum (BusyBox). macOS has only shasum.
T="$SIM/tablet"
tablet() {
  local c="${cmd//\/home\/root\//$T/home/root/}"
  if command -v sha256sum >/dev/null; then
    bash -c "$c"
  else
    bash -c 'sha256sum() { shasum -a 256 "$@"; }; '"$c"
  fi
}

# Writes the AppLoad extension of a new AppLoad (0.6.0 or newer).
new_appload() {
  mkdir -p "$T/home/root/xovi/extensions.d"
  printf 'appload 0.6.0 ApploadUtils fbRotation\n' >"$T/home/root/xovi/extensions.d/appload.so"
}

name="$(printf '%s' "$cmd" | sed -n '1s/^: \([a-z-]*\);.*/\1/p')"
case "$name" in
  probe) ;;
  authorize) IFS= read -r k && echo "$k" >>"$S/authorized" ;;
  info) cat "$S/model" "$S/os" ;;
  has-vellum) yes_no vellum ;;
  has-vellum-stale) yes_no vellum-stale ;;
  has-hashtab) yes_no hashtab ;;
  has-xovi) yes_no xovi ;;
  has-tripletap) yes_no tripletap ;;
  has-internet) if count offline; then echo no; else echo yes; fi ;;
  install-vellum)
    grep -q 'Vellum bootstrap' || { echo "fake ssh: no bootstrap script on stdin" >&2; exit 1; }
    cat <<'EOF'
Installing vellum...
Downloading apk.vellum...
Downloading vellum...
Downloading signing key...
Generating local signing key...
Configuring repositories...
Initializing local repository...
Initializing apk database...
Registering vellum package...
Updating package index...
Installing mount-utils...
Installing bash completion...
Added vellum to PATH in /home/root/.bashrc
Added completions in /home/root/.bashrc

Vellum installed successfully!
Run 'exec bash --login' to use vellum.
EOF
    touch "$S/vellum"
    ;;
  sync-vellum)
    if [ -e "$S/vellum-sync-fails" ]; then
      echo "ERROR: vellum: could not upgrade the packages."
      exit 1
    fi
    if [ -e "$S/vellum-still-stale" ]; then
      echo "warning: reenable has not been run since last OS upgrade."
      echo "OS upgraded... Run vellum upgrade... Run vellum reenable..."
      exit 0
    fi
    echo "Re-enabling packages after OS upgrade..."
    echo "  tripletap"
    echo "Done."
    # Vellum reenable restores the systemd unit of the power-button starter.
    rm -f "$S/vellum-stale"
    touch "$S/tripletap"
    ;;
  install-appload)
    cat <<'EOF'
fetch https://packages.vellum.delivery/aarch64/APKINDEX.tar.gz
OK: 112 distinct packages available
(1/5) Installing xovi (0.3.3-r2)
(2/5) Installing xovi-extensions (19.0.1-r0)
(3/5) Installing qt-resource-rebuilder (19.0.1-r0)
======================================================
  NOTE: Before using any QT modifications,
  you must run: xovi/rebuild_hashtable
======================================================
(4/5) Installing appload (0.6.0-r1)
(5/5) Installing remarkable-os (3.29.0.153-r0)
OK: 5 MiB in 9 packages
EOF
    new_appload
    ;;
  update-appload)
    # A7: Vellum is a wrapper of apk. `vellum add appload` does not update an installed AppLoad.
    case "$cmd" in
      *"/vellum update && "*"/vellum add -u appload"*) ;;
      *) echo "fake ssh: this command does not update AppLoad: $cmd" >&2; exit 1 ;;
    esac
    echo "fetch https://packages.vellum.delivery/aarch64/APKINDEX.tar.gz"
    echo "OK: 112 distinct packages available"
    if [ -e "$S/appload-update-fails" ]; then
      echo "ERROR: unable to upgrade appload: the download failed."
      exit 1
    fi
    if [ ! -e "$S/appload-update-noop" ]; then
      echo "(1/1) Upgrading appload (0.5.3-r0 -> 0.6.0-r1)"
      new_appload
    fi
    echo "OK: 5 MiB in 9 packages"
    ;;
  make-hashtab) touch "$S/hashtab"; rm -f "$S/xovi" ;; # rebuild_hashtable stops the user interface
  start-xovi) touch "$S/xovi" ;;
  install-tripletap)
    if [ -e "$S/tripletap-install-fails" ]; then
      echo "ERROR: could not install tripletap: the download failed."
      exit 1
    fi
    cat <<'EOF'
fetch https://packages.vellum.delivery/aarch64/APKINDEX.tar.gz
OK: 113 distinct packages available
(1/1) Installing xovi-tripletap (1.1.1-r0)
OK: 1 MiB in 2 packages
EOF
    # The Vellum package enables and starts the service, unless the state says that it does not.
    [ -e "$S/tripletap-off" ] || touch "$S/tripletap"
    ;;
  repair-tripletap)
    if [ -e "$S/tripletap-repair-fails" ]; then
      echo "xovi-tripletap: the service did not start."
      exit 1
    fi
    if [ -e "$S/tripletap-enable-sh" ]; then
      echo "xovi-tripletap: enabled and started with enable.sh."
    else
      echo "xovi-tripletap: re-enabled and started with vellum."
    fi
    rm -f "$S/tripletap-off"
    touch "$S/tripletap"
    ;;
  # The commands that read or change the files of the tablet: real commands in $SIM/tablet.
  has-appload | has-appload-rotation | has-old-patch | patch-hash | install-patch | app-files) tablet ;;
  delete-patch) [ -e "$S/patch-delete-fails" ] || tablet ;;
  install-app)
    tablet || exit
    # LCH-6, R§14.6 step 11: the program and the start file of the frontend must be executable.
    a="$T/home/root/xovi/exthome/appload/sudoku"
    if [ ! -x "$a/sudoku" ] || { [ -e "$a/backend/entry" ] && [ ! -x "$a/backend/entry" ]; }; then
      echo "fake ssh: install-app did not set the executable mode" >&2
      exit 1
    fi
    ;;
  *)
    echo "fake ssh: unknown remote command: $cmd" >&2
    exit 127
    ;;
esac
