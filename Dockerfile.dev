# syntax=docker/dockerfile:1
# check=skip=FromPlatformFlagConstDisallowed
# The fastest build of the app for the reMarkable Paper Pro (aarch64 Linux, musl), for development
# only (make install-dev). Do not use it for a release: the Dockerfile makes the release build.
#
#   docker build --platform linux/arm64 -f Dockerfile.dev --build-arg SUDOKU_VERSION=dev/update-icons --output type=local,dest=dist .
#
# Differences from the Dockerfile:
#
# - The Cargo profile `tablet-dev`: no LTO, many codegen units and incremental compilation.
# - BuildKit cache mounts keep the Cargo registry and target/ from one build to the next build. Thus
#   a change of the source compiles only the changed parts of the crate, not all of it again.
# - The linker is mold.
# - The build argument CARGO_FEATURES gives Cargo features, for example `corpus` (the corpus build:
#   make install-corpus, the skill `remarkable-corpus`).
# - The build argument SUDOKU_VERSION gives the version in the Settings panel: `dev`, or `dev/<name>`
#   with the name of the change, for example `dev/update-icons` (make install-dev DEV_NAME=update-icons).
#
# The result is dist/sudoku/, as from the Dockerfile.
FROM --platform=linux/arm64 rust:1.97-alpine AS build
RUN apk add --no-cache musl-dev mold
WORKDIR /src
ENV RUSTFLAGS="-C link-arg=-fuse-ld=mold"
# Only the files that the build reads (BuildKit sends only these files).
COPY Cargo.toml Cargo.lock ./
COPY src src
COPY assets assets
COPY images images
COPY scripts/icons scripts/icons
COPY tests/fixtures tests/fixtures
COPY video/demo-full.txt video/demo-full.txt
COPY appload/sudoku appload/sudoku
ARG SUDOKU_VERSION=dev
ARG CARGO_FEATURES=
RUN --mount=type=cache,id=sudoku-dev-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=sudoku-dev-target,target=/src/target \
    SUDOKU_VERSION="$SUDOKU_VERSION" cargo build --profile tablet-dev --locked --features "$CARGO_FEATURES" --bin sudoku \
 && mkdir -p /out && cp -R appload/sudoku /out/sudoku \
 && cp target/tablet-dev/sudoku /out/sudoku/sudoku && chmod 755 /out/sudoku/sudoku

FROM scratch AS export
COPY --from=build /out /
